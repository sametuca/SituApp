# Sunucu (server/.env, git'e girmez).
MESHY_API_KEY=your_meshy_api_key

# --- Supabase modu (üçü tanımlıysa kalıcı veri + token doğrulama açılır; yoksa demo/dosya modu) ---
SUPABASE_URL=https://lsaxidkolqyvpnwofljf.supabase.co
# GİZLİ anahtar (secret / service_role): yalnızca sunucuda, asla istemciye ya da depoya yazma.
SUPABASE_SERVICE_KEY=<secret key: sb_secret_... ya da legacy service_role JWT>
# Herkese açık anahtar (HS256/legacy token'larda /auth/v1/user çağrısı için)
SUPABASE_PUBLISHABLE_KEY=<publishable key: sb_publishable_...>
# 1 → tokensiz (ad tabanlı) misafir girişine de izin ver (yalnızca geliştirme). Kalıcı veri yazılmaz.
ALLOW_GUEST=

# --- Geri bildirim e-postası (isteğe bağlı). Alıcı adresi yalnızca burada durur; istemciye/depoya yazma. ---
# Ayarlı değilse geri bildirimler yalnızca server/data/feedback.jsonl dosyasına yazılır.
FEEDBACK_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Yönetici paneli (/admin) anahtarı: uzun rastgele bir metin. Boşsa panel kapalıdır.
ADMIN_KEY=

# --- Asset Studio (/studio) dahili uçları: Meshy üretimi, karakter kaydı, asset içe aktarma ---
# Bu uçlar yalnızca STUDIO_KEY (yoksa ADMIN_KEY) ile açılır. İkisi de boşsa uçlar kapalıdır (503).
# İstemci anahtarı /studio ekranındaki alana yapıştırır (yalnızca tarayıcıda saklanır).
STUDIO_KEY=
# 1 → studio uçlarını anahtarsız aç (YALNIZCA yerel geliştirme; üretimde ASLA).
ALLOW_STUDIO_OPEN=

# --- Ters proxy arkasında çalışıyorsan 1 yap: IP tabanlı limit/ban gerçek istemci IP'sini kullanır.
TRUST_PROXY=

# CORS: ön yüz ayrı origin'de barındırılıyorsa tam originleri virgülle ayırarak ekle.
# Örn. CORS_ORIGINS=https://oyun.example.com,https://www.example.com
CORS_ORIGINS=
